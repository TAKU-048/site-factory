{
  "name": "site-factory-cloudflare-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/contact.test.ts tests/store.test.ts tests/notify.test.ts tests/outbox.test.ts tests/routing.test.ts",
    "test:local": "node --experimental-strip-types --test tests/local-d1.test.ts",
