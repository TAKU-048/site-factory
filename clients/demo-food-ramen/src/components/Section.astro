---
// 中華そば 灯（制作デモ）専用のセクション描画。データは共通エンジンの site.json（type / variant / items / imageId）。
import site from '../data/site.json';
import {itemImages,asset,srcset,splitPrice,hours} from '../custom/media';
interface Props {section:{id:string;type:string;variant?:string;heading?:string;body?:string;items?:{title:string;body:string}[];imageId?:string};first?:boolean}
const {section:s,first=false}=Astro.props;
const image=asset(s.imageId);
const imgs=(itemImages[s.id]||[]).map(asset);
const v=s.variant||'default';
const H=first?'h1':'h2';
const lines=(t?:string)=>(t||'').split('\n');
const slotsJson=JSON.stringify(hours.slots);
const steam=[0,1,2];
---
{s.type==='hero'?(
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bowl">
    {image&&<img src={`/assets/${image.path}`} srcset={srcset(image.path)} sizes="(max-width: 768px) 120vw, 70vw" alt={image.alt} width="1600" height="1067" fetchpriority="high"/>}
    <svg class="steam" viewBox="0 0 300 400" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="10" stroke-linecap="round">{steam.map(i=><path class={`wisp w${i}`} d={`M${90+i*60} 380 C ${60+i*60} 300, ${130+i*60} 260, ${95+i*60} 180 S ${120+i*60} 60, ${100+i*60} 10`}/>)}</svg>
  </div>
  <div class="noren" aria-hidden="true">
    <span class="noren-rod"></span>
    <span class="cloth c1">中</span><span class="cloth c2">華</span><span class="cloth c3">そ</span><span class="cloth c4">ば</span>
  </div>
  <div class="lantern" aria-hidden="true"><span class="lantern-body"><span>灯</span></span></div>
  <div class="hero-copy">
    <h1 id="hero-title">{lines(s.heading).map((l,i)=><span class="line" style={`--i:${i}`}>{l}</span>)}</h1>
    <p class="hero-body">{s.body}</p>
    <p class="open-status" data-open-status data-closed={hours.closedDay} data-slots={slotsJson}><span class="dot" aria-hidden="true"></span><span data-status-text>営業時間 11:30〜15:00／17:30〜23:00</span></p>
  </div>
</section>
):s.type==='projects'&&v==='recommend'?(
<section class="section recommend" id={s.id}>
  <div class="wrap">
    <h2 class="section-title" data-reveal>{s.heading}</h2>
    <ul class="bowls">{s.items?.map((item,i)=>{const im=imgs[i];const p=splitPrice(item.body);return <li data-reveal style={`--i:${i}`}>
      <a href="/menu/"><span class="bowl-photo">{im&&<img src={`/assets/${im.path}`} srcset={srcset(im.path)} sizes="(max-width: 768px) 80vw, 30vw" alt={im.alt} width="800" height="800" loading="lazy"/>}</span>
      <span class="bowl-name">{item.title}</span><span class="bowl-price">{p.price}</span><span class="bowl-text">{p.text}</span></a></li>})}</ul>
    <a class="text-link" href="/menu/" data-reveal>お品書きをすべて見る</a>
  </div>
</section>
):s.type==='strengths'?(
<section class="section kodawari" id={s.id}>
  <div class="wrap"><h2 class="section-title" data-reveal>{s.heading}</h2>
  <ul class="kodawari-list">{s.items?.map((item,i)=><li data-reveal style={`--i:${i}`}><h3>{item.title}</h3><p>{item.body}</p></li>)}</ul></div>
</section>
):s.type==='company'&&v==='hours'?(
<section class="section hours" id={s.id}>
  <div class="wrap hours-grid">
    <div class="board" data-reveal><h2>{s.heading}</h2><p class="board-text">{s.body}</p>
      <p class="open-status open-status--board" data-open-status data-closed={hours.closedDay} data-slots={slotsJson}><span class="dot" aria-hidden="true"></span><span data-status-text>営業時間をご確認ください</span></p></div>
    <a class="hours-link" href="/shop/" data-reveal>お店の場所と<br/>アクセスを見る</a>
  </div>
</section>
):s.type==='company'?(
<section class="section shop-info" id={s.id}>
  <div class="wrap narrow"><h2 class="section-title" data-reveal>{s.heading}</h2>
  <dl class="info-list" data-reveal>{s.items?.map(item=><div><dt>{item.title}</dt><dd>{item.body}</dd></div>)}</dl>
  <p class="open-status open-status--light" data-open-status data-closed={hours.closedDay} data-slots={slotsJson}><span class="dot" aria-hidden="true"></span><span data-status-text>営業時間をご確認ください</span></p></div>
</section>
):s.type==='custom'&&v==='map'?(
<section class="section map" id={s.id}>
  <div class="wrap"><h2 class="section-title" data-reveal>{s.heading}</h2>
  <figure class="map-figure" data-reveal>
    <svg class="map-svg" data-route viewBox="0 0 800 420" role="img" aria-labelledby="map-desc">
      <desc id="map-desc">駅の改札を出て商店街をまっすぐ進み、二つ目の角の手前の左手にお店があります。デモのため実在の場所ではありません。</desc>
      <rect x="0" y="0" width="800" height="420" class="m-ground"/>
      <path class="m-block" d="M40 40h220v110H40zM300 40h200v110H300zM540 40h220v110H540zM40 250h220v130H40zM300 250h200v130H300zM540 250h220v130H540z"/>
      <path class="m-street" d="M0 200H800M280 0V420M520 0V420"/>
      <rect x="60" y="170" width="150" height="60" class="m-station"/><text x="135" y="207" class="m-label m-label--light">駅 改札</text>
      <text x="400" y="190" class="m-label m-small">商店街</text>
      <path class="m-route" d="M210 200H600V262"/>
      <g class="m-pin" transform="translate(600 285)"><circle r="26" class="m-pulse"/><circle r="15" class="m-dot"/><text y="56" class="m-label m-shop">灯</text></g>
      <text x="420" y="232" class="m-label m-small">徒歩3分</text>
    </svg>
    <figcaption>{s.body}<br/>（デモのため実在の場所ではありません）</figcaption>
  </figure></div>
</section>
):s.type==='services'?(
<section class={`section menu menu--${v}`} id={s.id}>
  <div class="wrap"><h2 class="section-title" data-reveal>{s.heading}</h2>
  <ul class="boards" aria-hidden="true">{s.items?.map((item,i)=>{const p=splitPrice(item.body);return <li style={`--i:${i}`} data-reveal><a href={`#${s.id}-${i}`} tabindex="-1"><span class="board-name">{item.title}</span><span class="board-price">{p.price.replace('円','')}</span></a></li>})}</ul>
  <ul class="menu-list">{s.items?.map((item,i)=>{const im=imgs[i];const p=splitPrice(item.body);return <li id={`${s.id}-${i}`} class={im?'has-photo':''} data-reveal>{im&&<span class="menu-photo"><img src={`/assets/${im.path}`} srcset={srcset(im.path)} sizes="(max-width: 768px) 40vw, 200px" alt={im.alt} width="400" height="400" loading="lazy"/></span>}<span class="menu-body"><span class="menu-name">{item.title}</span><span class="menu-text">{p.text}</span></span><span class="menu-price">{p.price}</span></li>})}</ul></div>
</section>
):s.type==='process'?(
<section class="section prep" id={s.id}>
  <div class="wrap"><h2 class="section-title" data-reveal>{s.heading}</h2>
  <ol class="prep-list">{s.items?.map((item,i)=>{const [time,...rest]=item.title.split('　');return <li data-reveal style={`--i:${i}`}><span class="prep-time">{time}</span><h3>{rest.join('　')}</h3><p>{item.body}</p></li>})}</ol></div>
</section>
):s.type==='intro'&&first?(
<section class="page-head" id={s.id}>
  <div class="wrap page-head-inner" data-reveal><H class="page-title">{s.heading}</H>{s.body&&<p class="page-lead">{s.body}</p>}</div>
</section>
):s.type==='prose'&&image?(
<section class="section story" id={s.id}>
  <div class="wrap story-grid"><figure class="story-photo" data-reveal><img src={`/assets/${image.path}`} srcset={srcset(image.path)} sizes="(max-width: 768px) 100vw, 55vw" alt={image.alt} width="800" height="1200" loading="lazy"/></figure><div data-reveal><h2>{s.heading}</h2><p>{s.body}</p></div></div>
</section>
):s.type==='cta'?(
<section class="visit" id={s.id}>
  <div class="visit-glow" aria-hidden="true"></div>
  <div class="wrap visit-inner" data-reveal><h2>{s.heading}</h2>{s.body&&<p>{s.body}</p>}<a class="button" href="/shop/">お店の場所を見る</a></div>
</section>
):(
<section class="section prose" id={s.id}>
  <div class="wrap narrow"><H data-reveal>{s.heading}</H>{s.body&&<p class="prose-body">{s.body}</p>}</div>
</section>
)}
