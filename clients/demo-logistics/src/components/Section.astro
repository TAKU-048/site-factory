---
// 株式会社朝凪運輸（制作デモ）専用のセクション描画。データは共通エンジンの site.json（type / variant / items / imageId）。
import ContactForm from './ContactForm.astro';
import {asset,srcset,parts,destinations,base,dispatch,truckRows} from '../custom/media';
interface Props {section:{id:string;type:string;variant?:string;heading?:string;body?:string;items?:{title:string;body:string}[];imageId?:string};first?:boolean}
const {section:s,first=false}=Astro.props;
const image=asset(s.imageId);
const v=s.variant||'default';
const H=first?'h1':'h2';
const lines=(t?:string)=>(t||'').split('\n');
const pad=(i:number)=>String(i+1).padStart(2,'0');
const dispatchJson=JSON.stringify(dispatch);
// 上から見たトラック（荷台にパレットが2列で並ぶ）。運転席の位置をそろえ、荷台の長さで車格の違いを見せる。
const truckShape=(n:number)=>{const deck=n*72+6;const cabX=612;const start=cabX-8-deck;const pallets=[];for(let c=0;c<n;c++)for(let r=0;r<2;r++)pallets.push({x:start+6+c*72,y:28+r*75,i:c*2+r});const rear=n>=8?[start+40,start+110]:[start+Math.max(30,deck*0.22)];return {deck,cabX,start,pallets,rear};};
const sizes=(s.items||[]).map(i=>i.title);
// 横から見た小さなトラック（アイコン）
const miniTruck=`<svg class="mini-truck" viewBox="0 0 64 34" aria-hidden="true"><rect x="2" y="4" width="38" height="20" rx="2"/><path d="M42 10h10l8 8v6H42z"/><circle cx="14" cy="28" r="4.5"/><circle cx="50" cy="28" r="4.5"/></svg>`;
---
{s.type==='hero'?(
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-photo">{image&&<img src={`/assets/${image.path}`} srcset={srcset(image.path)} sizes="100vw" alt={image.alt} width="1600" height="1066" fetchpriority="high"/>}</div>
  <svg class="streaks" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true" data-motion>
    <path pathLength="100" class="sk sk1" d="M-40 640 C 300 600, 620 520, 820 330 S 1100 60, 1260 20"/>
    <path pathLength="100" class="sk sk2" d="M-40 690 C 340 640, 660 560, 860 360 S 1120 90, 1260 60"/>
    <path pathLength="100" class="sk sk3 sk-amber" d="M-40 600 C 260 560, 560 470, 760 300 S 1060 40, 1260 -10"/>
    <path pathLength="100" class="sk sk4" d="M-40 720 C 380 690, 700 600, 900 400 S 1150 140, 1260 110"/>
    <path pathLength="100" class="sk sk5 sk-amber" d="M-40 660 C 320 620, 640 540, 840 345 S 1110 75, 1260 40"/>
  </svg>
  <div class="hero-inner">
    <p class="hero-kicker"><span class="kicker-line" aria-hidden="true"></span>貸切輸送・定期便・倉庫保管</p>
    <h1 id="hero-title">{lines(s.heading).map((l,i)=><span class="line" style={`--i:${i}`}><span>{l}</span></span>)}</h1>
    <p class="hero-body">{s.body}</p>
    <div class="hero-actions"><a class="button button--amber" href="/contact/">見積もりを依頼する</a><a class="button button--ghost" href="/recruit/">ドライバー募集を見る</a></div>
    <p class="dispatch" data-dispatch={dispatchJson}><span class="lamp" aria-hidden="true"></span><span data-dispatch-text>配車受付 平日 7:00〜19:00</span></p>
  </div>
  <button type="button" class="motion-toggle" data-motion-toggle aria-pressed="false">背景の動きを止める</button>
  <div class="hero-lane" aria-hidden="true"></div>
</section>
):s.type==='services'&&v==='lanes'?(
<section class="section lanes" id={s.id}>
  <div class="wrap">
    <div class="section-head" data-reveal><p class="eyebrow">SERVICE</p><h2>{s.heading}</h2>{s.body&&<p class="lead">{s.body}</p>}</div>
    <ol class="lane-list">{s.items?.map((item,i)=>{const p=parts(item.body);const im=asset(p.rest[0]);return <li data-reveal style={`--i:${i}`}>
      <a href="/service/" class="lane">
        <span class="lane-photo">{im&&<img src={`/assets/${im.path}`} srcset={srcset(im.path)} sizes="(max-width: 900px) 90vw, 30vw" alt={im.alt} width="800" height="600" loading="lazy"/>}</span>
        <span class="lane-no">{pad(i)}</span>
        <span class="lane-title">{item.title}</span>
        <span class="lane-text">{p.text}</span>
        <span class="lane-track" aria-hidden="true"><Fragment set:html={miniTruck}/></span>
      </a></li>})}</ol>
  </div>
</section>
):s.type==='custom'&&v==='route-map'?(
<section class="section routes" id={s.id} data-routes>
  <div class="wrap routes-grid">
    <div class="routes-text" data-reveal>
      <p class="eyebrow eyebrow--dark">AREA</p>
      <h2>{s.heading}</h2>
      <ul class="route-list">{s.items?.map((item,i)=><li><button type="button" data-route={i} aria-pressed="false"><span class="route-name">{item.title}</span><span class="route-time">{item.body}</span></button></li>)}</ul>
      {s.body&&<p class="note note--dark">{s.body}</p>}
      <button type="button" class="motion-toggle motion-toggle--inline" data-motion-toggle aria-pressed="false">走る点の動きを止める</button>
    </div>
    <figure class="route-map" data-reveal>
      <svg viewBox="0 0 640 470" role="img" aria-labelledby="route-desc" data-route-svg>
        <desc id="route-desc">拠点から東京23区、横浜・川崎、千葉・幕張、さいたま・大宮、宇都宮・北関東、八王子・多摩へ線が伸びる模式図。方角の目安で、実際の地図ではありません。</desc>
        <defs><pattern id="dots" width="16" height="16" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.2" class="m-dot"/></pattern></defs>
        <rect width="640" height="470" fill="url(#dots)"/>
        <path class="m-bay" d="M410 470 C 420 420, 470 395, 470 360 C 470 330, 500 330, 520 400 C 535 440, 560 455, 640 470 Z"/>
        <text x="470" y="440" class="m-water">東京湾</text>
        {s.items?.map((item,i)=>{const d=destinations[item.title];if(!d)return null;const path=`M${base.x} ${base.y} Q ${d.c[0]} ${d.c[1]} ${d.x} ${d.y}`;return <g class="m-route" data-route-line={i} style={`--i:${i}`}>
          <path id={`rt-${i}`} class="m-line" d={path} pathLength="1"/>
          <path class="m-glow" d={path} pathLength="1"/>
          <circle r="5" class="m-runner" data-motion><animateMotion dur={`${2.6+i*0.35}s`} repeatCount="indefinite" rotate="auto"><mpath href={`#rt-${i}`}/></animateMotion></circle>
          <circle cx={d.x} cy={d.y} r="7" class="m-end"/>
          <text x={d.x} y={d.y-16} class="m-label" text-anchor="middle">{item.title}</text>
        </g>})}
        <g class="m-base" transform={`translate(${base.x} ${base.y})`}><circle r="30" class="m-pulse" data-motion/><circle r="16" class="m-core"/><text y="46" text-anchor="middle" class="m-label m-label--base">拠点</text></g>
      </svg>
      <figcaption class="sr-only">主な地域までの走行時間の目安は、左の一覧に記載しています。</figcaption>
    </figure>
  </div>
</section>
):s.type==='custom'&&v==='truck-picker'?(
<section class="section picker" id={s.id} data-picker>
  <div class="wrap">
    <div class="section-head" data-reveal><p class="eyebrow">TRUCK</p><h2>{s.heading}</h2>{s.body&&<p class="lead">{s.body}</p>}</div>
    <div class="picker-box" data-reveal>
      <div class="picker-tabs" role="group" aria-label="車の大きさを選ぶ">{s.items?.map((item,i)=><button type="button" data-size={item.title} aria-pressed={i===1?'true':'false'}><span class="size-num">{item.title.replace('t','')}</span><span class="size-unit">t</span></button>)}</div>
      <div class="picker-stage" aria-hidden="true">
        <span class="stage-line"></span>
        {sizes.map((size,k)=>{const t=truckShape(truckRows[size]||2);return <svg class={`truck ${k===1?'is-active':''}`} data-truck={size} viewBox="0 0 720 200">
          {t.rear.map(x=><g class="tyre"><rect x={x} y="10" width="36" height="13" rx="4"/><rect x={x} y="177" width="36" height="13" rx="4"/></g>)}
          <g class="tyre"><rect x={t.cabX+18} y="16" width="36" height="13" rx="4"/><rect x={t.cabX+18} y="171" width="36" height="13" rx="4"/></g>
          <rect class="deck" x={t.start} y="20" width={t.deck} height="160" rx="6"/>
          {t.pallets.map(p=><rect class="pallet" x={p.x} y={p.y} width="66" height="69" rx="3" style={`--d:${p.i}`}/>)}
          <rect class="cab" x={t.cabX} y="30" width="92" height="140" rx="20"/>
          <rect class="glass" x={t.cabX+64} y="42" width="18" height="116" rx="7"/>
          <rect class="mirror" x={t.cabX+50} y="18" width="10" height="14" rx="2"/><rect class="mirror" x={t.cabX+50} y="168" width="10" height="14" rx="2"/>
        </svg>})}
      </div>
      <div class="picker-info" aria-live="polite">{s.items?.map((item,i)=>{const p=parts(item.body);return <div class="picker-detail" data-detail={item.title} hidden={i!==1}><p class="cap"><span class="cap-size">{item.title}</span>{p.text}</p><p>{p.rest[0]}</p></div>})}</div>
      <p class="picker-note">上から見た荷台に、1.1m角のパレットを2列で並べた場合の目安です。</p>
    </div>
  </div>
</section>
):s.type==='strengths'&&v==='promise'?(
<section class="section promise" id={s.id}>
  <div class="wrap">
    <div class="section-head" data-reveal><p class="eyebrow">PROMISE</p><h2>{s.heading}</h2></div>
    <ul class="signs">{s.items?.map((item,i)=><li class="sign" data-reveal style={`--i:${i}`}><span class="sign-plate"><span class="sign-no">{pad(i)}</span><h3>{item.title}</h3><p>{item.body}</p><svg class="sign-arrow" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 36V8M8 18 20 6l12 12" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="sign-pole" aria-hidden="true"></span></li>)}</ul>
  </div>
</section>
):s.type==='process'&&v==='flow'?(
<section class="section flow" id={s.id} data-progress>
  <div class="wrap">
    <div class="section-head" data-reveal><p class="eyebrow">FLOW</p><h2>{s.heading}</h2></div>
    <div class="flow-road">
      <span class="road-bar" aria-hidden="true"><span class="road-truck"><Fragment set:html={miniTruck}/></span></span>
      <ol class="flow-list">{s.items?.map((item,i)=><li data-reveal style={`--i:${i}`}><span class="km">{pad(i)}</span><h3>{item.title}</h3><p>{item.body}</p></li>)}</ol>
    </div>
  </div>
</section>
):s.type==='cta'&&v==='recruit'?(
<section class="recruit-band" id={s.id}>
  <div class="band-photo" data-reveal>{asset('logi-dusk')&&<img src={`/assets/${asset('logi-dusk')!.path}`} srcset={srcset(asset('logi-dusk')!.path)} sizes="(max-width: 900px) 100vw, 55vw" alt="" width="1600" height="1066" loading="lazy"/>}<span class="headlights" aria-hidden="true"><i></i><i></i></span></div>
  <div class="band-text" data-reveal><p class="eyebrow eyebrow--dark">RECRUIT</p><h2>{lines(s.heading).map(l=><span class="block">{l}</span>)}</h2><p>{s.body}</p><a class="button button--amber" href="/recruit/">募集の内容を見る</a></div>
</section>
):s.type==='cta'?(
<section class={`shutter-cta shutter-cta--${v}`} id={s.id} data-reveal>
  <span class="shutter" aria-hidden="true"></span>
  <div class="wrap shutter-inner">
    <h2>{lines(s.heading).map(l=><span class="block">{l}</span>)}</h2>
    {s.body&&<p>{s.body}</p>}
    <div class="cta-actions">{v==='entry'?<a class="button button--ink" href="/contact/?kind=recruit">応募・見学を申し込む</a>:<a class="button button--ink" href="/contact/">見積もりを依頼する</a>}</div>
  </div>
</section>
):s.type==='intro'&&v==='recruit-head'?(
<section class="page-hero" id={s.id}>
  {image&&<div class="page-hero-photo"><img src={`/assets/${image.path}`} srcset={srcset(image.path)} sizes="100vw" alt={image.alt} width="1600" height="1505" fetchpriority="high"/></div>}
  <div class="wrap page-hero-inner"><p class="eyebrow eyebrow--dark">DRIVER RECRUIT</p><H class="page-hero-title">{lines(s.heading).map((l,i)=><span class="line" style={`--i:${i}`}><span>{l}</span></span>)}</H><p class="page-hero-lead">{s.body}</p></div>
</section>
):s.type==='intro'?(
<section class={`page-head ${image?'page-head--photo':''}`} id={s.id}>
  <div class="wrap page-head-inner">
    <div class="page-head-text" data-reveal><H class="page-title">{s.heading}</H>{s.body&&<p class="page-lead">{s.body}</p>}</div>
    {image&&<figure class="page-head-photo" data-reveal><img src={`/assets/${image.path}`} srcset={srcset(image.path)} sizes="(max-width: 900px) 90vw, 45vw" alt={image.alt} width="1200" height="1600" fetchpriority="high"/></figure>}
  </div>
  <div class="page-lane" aria-hidden="true"></div>
</section>
):s.type==='services'&&v==='detail'?(
<section class="section detail" id={s.id}>
  <div class="wrap"><h2 class="sr-only">{s.heading}</h2>
  <ol class="detail-list">{s.items?.map((item,i)=>{const p=parts(item.body);const im=asset(p.rest[0]);return <li class="detail-row">
    <figure class="detail-photo" data-reveal>{im&&<img src={`/assets/${im.path}`} srcset={srcset(im.path)} sizes="(max-width: 900px) 90vw, 46vw" alt={im.alt} width="800" height="600" loading="lazy"/>}</figure>
    <div class="detail-text" data-reveal><span class="lane-no">{pad(i)}</span><h3>{item.title}</h3><p>{p.text}</p></div></li>})}</ol></div>
</section>
):s.type==='custom'&&v==='spec'?(
<section class="section spec" id={s.id}>
  <div class="wrap"><div class="section-head" data-reveal><p class="eyebrow">FLEET</p><h2>{s.heading}</h2></div>
  <ul class="spec-list">{s.items?.map((item,i)=><li data-reveal style={`--i:${i}`}><span class="spec-icon" style={`--len:${[0.45,0.7,0.7,1][i]??0.7}`} aria-hidden="true"><span class="spec-box"></span><span class="spec-cab"></span></span><span class="spec-name">{item.title}</span><span class="spec-use">{item.body}</span></li>)}</ul>
  {s.body&&<p class="note">{s.body}</p>}</div>
</section>
):s.type==='faq'?(
<section class="section faq" id={s.id}>
  <div class="wrap narrow"><h2 data-reveal>{s.heading}</h2>
  <div class="faq-list">{s.items?.map(item=><details data-reveal><summary><span class="q" aria-hidden="true">Q</span><span>{item.title}</span></summary><p>{item.body}</p></details>)}</div></div>
</section>
):s.type==='services'&&v==='jobs'?(
<section class="section jobs" id={s.id}>
  <div class="wrap"><div class="section-head" data-reveal><p class="eyebrow">JOBS</p><h2>{s.heading}</h2></div>
  <ul class="job-list">{s.items?.map((item,i)=>{const p=parts(item.body);return <li class="job" data-reveal data-no={pad(i)} style={`--i:${i}`}><h3>{item.title}</h3><p>{p.text}</p><ul class="tags">{p.rest.map(t=><li>{t}</li>)}</ul></li>})}</ul></div>
</section>
):s.type==='process'?(
<section class="section drive-day" id={s.id} data-progress>
  <div class="wrap narrow"><div class="section-head" data-reveal><p class="eyebrow">ONE DAY</p><h2>{s.heading}</h2></div>
  <div class="day-road">
    <span class="day-bar" aria-hidden="true"><span class="day-truck"><Fragment set:html={miniTruck}/></span></span>
    <ol class="day-list">{s.items?.map((item,i)=>{const [time,...rest]=item.title.split('　');return <li data-reveal><span class="day-time">{time}</span><h3>{rest.join('　')}</h3><p>{item.body}</p></li>})}</ol>
  </div></div>
</section>
):s.type==='strengths'?(
<section class={`section checks checks--${v}`} id={s.id}>
  <div class="wrap"><div class="section-head" data-reveal><p class="eyebrow">{v==='safety'?'SAFETY':'BENEFITS'}</p><h2>{s.heading}</h2></div>
  <ul class="check-list">{s.items?.map((item,i)=><li data-reveal style={`--i:${i}`}><svg class="check" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="21"/><path d="M14 25l7 7 13-15"/></svg><h3>{item.title}</h3><p>{item.body}</p></li>)}</ul></div>
</section>
):s.type==='company'?(
<section class="section info" id={s.id}>
  <div class="wrap narrow"><h2 data-reveal>{s.heading}</h2>
  <dl class="info-list" data-reveal>{s.items?.map(item=><div><dt>{item.title}</dt><dd>{item.body}</dd></div>)}</dl>
  {s.body&&<p class="note">{s.body}</p>}</div>
</section>
):s.type==='form'?(
<section class="section form-section" id={s.id}>
  <div class="wrap narrow"><h2 class="sr-only">{s.heading}</h2><ContactForm/></div>
</section>
):(
<section class="section prose" id={s.id}>
  <div class="wrap narrow"><H data-reveal>{s.heading}</H>{s.body&&<p class="prose-body">{s.body}</p>}</div>
</section>
)}
