---
import site from '../data/site.json';
import '../styles/site.css';
import '../custom/client.css';
interface Props {title:string;description:string;slug?:string}
const {title,description,slug=''}=Astro.props;
const canonical=new URL(slug?`/${slug}/`:'/',Astro.site);
const design=site.design;
const tokens=Object.entries(design.tokens).map(([k,v])=>`--${k}:${v}`).join(';');
const nav=site.pages.filter(p=>p.slug!==''&&p.slug!=='privacy'&&p.slug!=='entry');
const shortName=site.company.name.replace('（制作デモ）','');
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | {site.company.name}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={`${title} | ${site.company.name}`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta name="robots" content="noindex, nofollow"/><meta name="theme-color" content={design.tokens.ink}/></head>
<body data-design={design.id} data-page={slug||'home'} style={tokens}>
<a class="skip-link" href="#main">本文へ移動</a>
{site.demo&&<div class="demo-notice">ホームページ制作の見本として作った架空の会社のサイトです。写真は素材サイト（Unsplash）のもので、実在の会社・人物・求人ではありません。</div>}
<header class="site-header">
  <a class="brand" href="/" aria-label={`${shortName} 採用情報 トップ`}><span class="brand-mark" aria-hidden="true"></span><span class="brand-name">{shortName}</span><span class="brand-sub">採用情報</span></a>
  <nav aria-label="メインナビゲーション">{nav.map(p=><a href={`/${p.slug}/`} aria-current={p.slug===slug?'page':undefined}>{p.title}</a>)}</nav>
  <a class="header-entry" href="/entry/" aria-current={slug==='entry'?'page':undefined}>見学・応募する</a>
</header>
<main id="main"><slot/></main>
<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-name">{shortName}</p>
    <p class="footer-philosophy">{site.company.philosophy}</p>
    <nav class="footer-links" aria-label="フッターナビゲーション"><a href="/">採用情報トップ</a>{nav.map(p=><a href={`/${p.slug}/`}>{p.title}</a>)}<a href="/entry/">見学・応募する</a><a href="/privacy/">プライバシーポリシー</a></nav>
    <p class="footer-note">このサイトはデモです。掲載内容はすべて架空の例です。</p>
  </div>
</footer>
{slug!=='entry'&&<a class="sticky-entry" href="/entry/">見学・応募する</a>}
<script>
// トップでは、ヒーロー（応募ボタンを含む）が見えている間だけ画面下の応募ボタンを隠す
const hero=document.querySelector('.hero');
if(hero&&'IntersectionObserver' in window){new IntersectionObserver(([e])=>document.body.classList.toggle('hero-in-view',e.isIntersecting)).observe(hero);}
</script>
<script>import '../scripts/motion';</script>
</body></html>
