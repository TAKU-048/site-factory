---
import site from '../data/site.json';
import Hero from './Hero.astro';
import Feature from '../custom/Feature.astro';
interface Props {section:{id:string;type:string;variant?:string;heading?:string;body?:string;items?:{title:string;body:string}[];imageId?:string};first?:boolean}
const {section:s,first=false}=Astro.props;
const image=site.assets.find(a=>a.id===s.imageId);
---
{s.type==='hero'?<Hero {...s}/>:s.type==='custom'?<section class="section-wrap" id={s.id}><Feature heading={s.heading} body={s.body}/></section>:<section id={s.id} class={`section-wrap section--${s.type} variant--${s.variant||'default'}`}>
<div class="section-heading">{first?<h1>{s.heading}</h1>:<h2>{s.heading}</h2>}{s.body&&<p class="section-intro">{s.body}</p>}</div>
{s.type==='company'?<dl class="company-list"><div><dt>名称</dt><dd>{site.company.name}</dd></div><div><dt>大切にすること</dt><dd>{site.company.philosophy||site.company.description}</dd></div><div><dt>所在地</dt><dd>{site.company.address}</dd></div><div><dt>連絡先</dt><dd>{site.company.email}</dd></div></dl>:s.type==='form'?<div class="contact-layout"><div class="contact-note"><p>まだ言葉になっていないことから、お聞かせください。</p><p class="small">このフォームは接続前の表示確認用です。入力内容は送信・保存されません。</p></div><form aria-describedby="form-status"><fieldset disabled><legend class="sr-only">お問い合わせ内容</legend>{site.form.fields.map((field,i)=><div class="form-row"><label for={`field-${i}`}>{({name:'お名前',email:'メールアドレス',message:'ご相談内容',company:'会社名',phone:'電話番号'} as Record<string,string>)[field]||field}</label>{field==='message'?<textarea id={`field-${i}`} name={field} rows={5}/>:<input id={`field-${i}`} name={field} type={field==='email'?'email':'text'}/>}</div>)}<button type="button" disabled>送信機能は未接続です</button></fieldset><p id="form-status" class="small">公開前に接続・実送信確認を行います。</p></form></div>:s.type==='cta'?<a class="contact-link" href="/contact/">ご相談について<svg viewBox="0 0 24 24" width="32" height="32" stroke="currentColor" fill="none" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a>:null}
{s.items&&s.items.length>0&&(s.type==='faq'?<div class="faq-list">{s.items.map(item=><details><summary>{item.title}<span aria-hidden="true">＋</span></summary><p>{item.body}</p></details>)}</div>:<div class={`item-list item-list--${s.type}`}>{s.items.map((item,i)=><article>{s.type==='process'&&<span class="step-label">STEP {i+1}</span>}<h3>{item.title}</h3><p>{item.body}</p></article>)}</div>)}
{image&&<figure class="section-image"><img src={`/assets/${image.path}`} alt={image.alt} width="1600" height="1600" loading="lazy"/></figure>}
</section>}
